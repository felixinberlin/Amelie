{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://felixinberlin.github.io/Amelie/07-demos/vernichtungs-offenlegungsregister/anhang1-schema.json",
  "title": "Offenlegung nach Art. 24 ESPR — vorläufiges Anhang-I-Schema (DVO (EU) 2026/2)",
  "description": "VORLÄUFIG. Der Normtext der DVO (EU) 2026/2 (Art. 2/3, Anhang I), der Delegierten VO (EU) 2026/296 und von ESPR Art. 24 Abs. 1 wurde nicht gelesen (Seitenabruf gesperrt). Alle Fachfelder sind Annahmen aus Sekundärquellen (Kanzlei- und Anbieterschnipsel), siehe x-annahmen. Es werden bewusst keine Feldnummern aus Anhang I behauptet. Lizenz: CC0 1.0 Public Domain.",
  "schemaStatus": "vorläufig",
  "x-annahmen": [
    { "feld": "stueck", "annahme": "Menge je Warengruppe in Stück", "herkunft": "Kanzlei-Schnipsel (Cooley 07.05.2026, Freshfields) zu ESPR Art. 24 Abs. 1 lit. a; Normtext nicht gelesen" },
    { "feld": "gewichtKg", "annahme": "Gewicht je Warengruppe in Kilogramm", "herkunft": "Kanzlei- und Anbieterschnipsel zu DVO (EU) 2026/2 Anhang I; Normtext nicht gelesen" },
    { "feld": "gruende", "annahme": "Gründe als Codes aus der Ausnahmeliste (ESPR Art. 25 Abs. 5, präzisiert durch Delegierte VO (EU) 2026/296); Liste sinngemäß, nicht wortgleich", "herkunft": "Kanzleischnipsel (Linklaters, Cattwyk); Normtext nicht gelesen" },
    { "feld": "behandlungswege", "annahme": "Anteile je Behandlungsweg entlang der Abfallhierarchie in Prozent", "herkunft": "Schnipsel zu ESPR Art. 24 Abs. 1 lit. c; Prozentform ist eine Annahme" },
    { "feld": "cnCode", "annahme": "Warengruppe als achtstelliger KN/CN-Code", "herkunft": "Anbieterschnipsel (Generation Impact) zu Anhang I; Normtext nicht gelesen" },
    { "feld": "geschaetzt", "annahme": "Kennzeichnung, ob Mengen gemessen oder geschätzt sind", "herkunft": "Kanzleischnipsel zu DVO (EU) 2026/2; Normtext nicht gelesen" }
  ],
  "type": "object",
  "required": ["unternehmen", "geschaeftsjahr", "format", "quelle", "positionen"],
  "additionalProperties": false,
  "properties": {
    "unternehmen": { "type": "string", "minLength": 1 },
    "geschaeftsjahr": { "type": "integer", "minimum": 2025 },
    "synthetisch": { "type": "boolean", "description": "true = konstruierte Testdaten, keine echte Offenlegung" },
    "format": { "enum": ["tabelle", "freitext"] },
    "freitext": { "type": "string" },
    "quelle": {
      "type": "object",
      "required": ["url", "abgerufenAm"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "abgerufenAm": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "archivSnapshot": { "type": "string" }
      }
    },
    "positionen": { "type": "array", "items": { "$ref": "#/definitions/position" } }
  },
  "definitions": {
    "unbekannt": { "const": "unbekannt" },
    "position": {
      "type": "object",
      "required": ["id", "warengruppe", "stueck", "gewichtKg", "gruende", "behandlungswege"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "warengruppe": { "type": "string" },
        "cnCode": { "type": "string", "x-annahme": true },
        "stueck": { "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/definitions/unbekannt" }], "x-annahme": true },
        "gewichtKg": { "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/definitions/unbekannt" }], "x-annahme": true },
        "geschaetzt": { "type": "boolean", "x-annahme": true },
        "gruende": {
          "x-annahme": true,
          "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "$ref": "#/definitions/unbekannt" }]
        },
        "behandlungswege": {
          "x-annahme": true,
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["weg", "anteilProzent"],
                "additionalProperties": false,
                "properties": {
                  "weg": { "enum": ["vorbereitung-wiederverwendung", "wiederaufbereitung", "recycling", "sonstige-verwertung", "beseitigung"] },
                  "anteilProzent": { "type": "number", "minimum": 0 }
                }
              }
            },
            { "$ref": "#/definitions/unbekannt" }
          ]
        }
      }
    }
  },
  "x-ausnahmeGruende": [
    "gesundheit-hygiene-sicherheit",
    "schaden-nicht-reparierbar",
    "ungeeignet-fuer-zweck",
    "spende-abgelehnt",
    "ungeeignet-fuer-wiederverwendung",
    "geistiges-eigentum",
    "geringste-umweltwirkung"
  ]
}
