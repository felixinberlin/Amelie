{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://felixinberlin.github.io/Amelie/07-demos/vernichtungs-offenlegungsregister/anhang1-schema.json",
  "title": "Übertragungsmodell: DVO2026/2 Anhang I (kein Rechtsurteil)",
  "description": "Anhang I, Artikel1–3 im Volltext geprüft. Historisch standardmäßig; zukünftiger Formatvergleich nur ausdrücklich. Quelle unverändert erhalten, unbekannte Felder zulässig; keine Pflichtfeststellung. CC0.",
  "schemaStatus": "gegen Normtext geprüft am 2026-10-08",
  "x-annahmen": [
    {
      "feld": "stueck",
      "herkunft": "DVO2026/2 Anhang I Abschnitt2/Artikel3"
    },
    {
      "feld": "gewichtKg",
      "herkunft": "DVO2026/2 Anhang I Abschnitt2/Artikel3"
    },
    {
      "feld": "gruende",
      "herkunft": "DVO2026/2 Anhang I Abschnitt2/Artikel3"
    },
    {
      "feld": "behandlungswege",
      "herkunft": "DVO2026/2 Anhang I Abschnitt2/Artikel3"
    },
    {
      "feld": "cnCode",
      "herkunft": "DVO2026/2 Anhang I Abschnitt2/Artikel3"
    },
    {
      "feld": "schaetzungStueck/schaetzungGewicht",
      "herkunft": "DVO2026/2 Anhang I Abschnitt2/Artikel3"
    }
  ],
  "type": "object",
  "required": [
    "unternehmen",
    "geschaeftsjahr",
    "format",
    "quelle",
    "positionen"
  ],
  "additionalProperties": false,
  "properties": {
    "unternehmen": {
      "type": "string",
      "minLength": 1
    },
    "geschaeftsjahr": {
      "type": "integer",
      "minimum": 2025
    },
    "synthetisch": {
      "type": "boolean",
      "description": "true = konstruierte Testdaten, keine echte Offenlegung"
    },
    "format": {
      "enum": [
        "tabelle",
        "freitext"
      ]
    },
    "freitext": {
      "type": "string"
    },
    "quelle": {
      "type": "object",
      "required": [
        "url",
        "abgerufenAm"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "abgerufenAm": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "archivSnapshot": {
          "type": "string"
        }
      }
    },
    "positionen": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/position"
      }
    },
    "pruefmodus": {
      "enum": [
        "historisch",
        "anhang-i"
      ]
    },
    "zeitraum": {
      "type": "object",
      "required": [
        "von",
        "bis"
      ],
      "additionalProperties": false,
      "properties": {
        "von": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "bis": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "rechtstraeger": {
      "type": "object",
      "required": [
        "kennung",
        "typ",
        "art",
        "mitglieder"
      ],
      "additionalProperties": false,
      "properties": {
        "kennung": {
          "type": "string",
          "minLength": 1
        },
        "typ": {
          "type": "string",
          "minLength": 1
        },
        "art": {
          "enum": [
            "einzeln",
            "konsolidiert"
          ]
        },
        "mitglieder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "praevention": {
      "type": "object",
      "required": [
        "getroffen",
        "geplant"
      ],
      "additionalProperties": false,
      "properties": {
        "getroffen": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "unbekannt"
            }
          ]
        },
        "geplant": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "unbekannt"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "unbekannt": {
      "const": "unbekannt"
    },
    "position": {
      "type": "object",
      "required": [
        "id",
        "warengruppe",
        "stueck",
        "gewichtKg",
        "gruende",
        "behandlungswege"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "warengruppe": {
          "type": "string"
        },
        "cnCode": {
          "type": "string"
        },
        "stueck": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/unbekannt"
            }
          ]
        },
        "gewichtKg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/unbekannt"
            }
          ]
        },
        "geschaetzt": {
          "type": "boolean"
        },
        "gruende": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "$ref": "#/definitions/unbekannt"
            }
          ]
        },
        "behandlungswege": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "weg",
                  "anteilProzent"
                ],
                "additionalProperties": false,
                "properties": {
                  "weg": {
                    "enum": [
                      "vorbereitung-wiederverwendung",
                      "recycling",
                      "sonstige-verwertung",
                      "beseitigung",
                      "unbekannt"
                    ]
                  },
                  "anteilProzent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            },
            {
              "$ref": "#/definitions/unbekannt"
            }
          ]
        },
        "schaetzungStueck": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unbekannt"
            }
          ]
        },
        "schaetzungGewicht": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unbekannt"
            }
          ]
        },
        "verpackung": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unbekannt"
            }
          ]
        },
        "vernichtetProzent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "const": "unbekannt"
            }
          ]
        }
      }
    }
  }
}
