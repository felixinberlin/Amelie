{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "strassenverzeichnis-schema.json",
  "title": "Straßenverzeichnis einer Gemeinde (Straßennamen-Prüfer)",
  "description": "Eingabeformat des Prüfers. Lizenz: CC0 1.0 Public Domain.",
  "schemaStatus": "vorläufig: nur aus dem Dossier abgeleitet, noch nicht gegen einen echten GovData- oder OSM-Auszug geprüft",
  "type": "object",
  "required": ["schemaVersion", "datenart", "gemeinde", "strassen"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "datenart": { "enum": ["synthetisch", "govdata", "osm-overpass", "amtlich-uebertragen"] },
    "hinweis": { "type": "string" },
    "gemeinde": { "type": "string" },
    "quelle": {
      "type": "object",
      "description": "Für echte Daten Pflicht: Abrufdatum, URL, sha256 (Ticket 01).",
      "properties": {
        "url": { "type": "string" },
        "abgerufenAm": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "strassen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": { "type": "string", "description": "eindeutig innerhalb der Liste" },
          "name": { "type": "string", "minLength": 1 },
          "ortsteil": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
