{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amelie.dev/schemas/chemhazard/product.schema.json",
  "title": "ChemHazard Product Definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "brand",
    "chemicalGroups",
    "hazardStatements",
    "dataLane",
    "sourceType",
    "provenance",
    "hazardsConfirmed",
    "completenessReviewed",
    "currentVersionChecked",
    "reviewMetadata",
    "hazardStatementsEvidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "gtins": {
      "description": "Canonical GTIN-14; check digit and documented per-mapping confirmation required for lookup.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{14}$"
      },
      "uniqueItems": true
    },
    "ufi": {
      "description": "Unique Formula Identifier vom Etikett (CLP Anhang VIII), wie im SDB Abschnitt 1.1 genannt.",
      "type": "string",
      "pattern": "^[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}$"
    },
    "giscode": {
      "description": "Display only; never a product lookup identifier.",
      "type": "string",
      "pattern": "^[A-Z]{1,3}[0-9]{1,3}$"
    },
    "chemicalGroups": {
      "description": "Aus casNumbers, hazardStatements und ph abgeleitet (scripts/chemhazard-sds.mjs, GROUP_RULES), nie von Hand gesetzt.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "acid",
          "hypochlorite",
          "ammonia",
          "peroxide",
          "oxidizer",
          "caustic_lye",
          "flammable",
          "organic_solvent",
          "neutral",
          "unknown"
        ]
      },
      "uniqueItems": true
    },
    "hazardStatements": {
      "description": "H- und EUH-Sätze des Gemischs aus SDB Abschnitt 2.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(EUH[0-9]{3}A?|H[234][0-9]{2}[A-Za-z]{0,2})$"
      }
    },
    "casNumbers": {
      "description": "CAS-Nummern aus SDB Abschnitt 3.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$"
      },
      "uniqueItems": true
    },
    "ph": {
      "description": "Reported SDS pH, retaining concentration when specified; diluted measurements do not classify the concentrate.",
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 14
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 14
        },
        "concentrationPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "dataLane": {
      "type": "string",
      "enum": [
        "public_law",
        "licensed_wingis",
        "open_community"
      ]
    },
    "sourceType": {
      "description": "sds = Sicherheitsdatenblatt (REACH Art. 31); ingredient_datasheet = Datenblatt nach Detergenzien-VO Anhang VII D; none = unbelegt.",
      "type": "string",
      "enum": [
        "sds",
        "ingredient_datasheet",
        "none"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceDocument",
        "verificationDate"
      ],
      "properties": {
        "sourceDocument": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "sourceHost": {
          "type": "string",
          "enum": [
            "manufacturer",
            "retailer"
          ]
        },
        "revisionDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verificationDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "gtinSource": {
          "type": "string",
          "pattern": "^https://"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "activeIngredients": {
      "type": "string"
    },
    "descriptionDe": {
      "type": "string"
    },
    "descriptionEn": {
      "type": "string"
    },
    "typicalUseDe": {
      "type": "string"
    },
    "typicalUseEn": {
      "type": "string"
    },
    "hazardsConfirmed": {
      "type": "boolean"
    },
    "completenessReviewed": {
      "type": "boolean"
    },
    "currentVersionChecked": {
      "type": "boolean"
    },
    "reviewMetadata": {
      "type": "object",
      "properties": {
        "hazardsConfirmed": {
          "type": "object",
          "required": [
            "date",
            "basis"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "completenessReviewed": {
          "type": "object",
          "required": [
            "date",
            "basis"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "currentVersionChecked": {
          "type": "object",
          "required": [
            "date",
            "basis"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gtinMappings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]{14}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "confirmed"
        ],
        "properties": {
          "confirmed": {
            "type": "boolean"
          },
          "review": {
            "type": "object",
            "required": [
              "date",
              "basis"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "confirmed": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "review"
          ]
        }
      }
    },
    "hazardStatementsEvidence": {
      "type": "string",
      "enum": [
        "documented",
        "documented_absence",
        "undocumented"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "hazardsConfirmed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reviewMetadata": {
            "required": [
              "hazardsConfirmed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completenessReviewed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reviewMetadata": {
            "required": [
              "completenessReviewed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "currentVersionChecked": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reviewMetadata": {
            "required": [
              "currentVersionChecked"
            ]
          }
        }
      }
    }
  ]
}
