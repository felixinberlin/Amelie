{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amelie.berlin/schemas/tarot-spread-v1.json",
  "title": "TarotSpreadDefinition",
  "description": "Herstellerunabhängige Graph-Spezifikation für Tarot- und Orakel-Legesysteme mit topologischen Slots und typisierten Kanten.",
  "type": "object",
  "required": ["$schema", "id", "name", "deckContract", "slots", "relations"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": { "type": "string" },
    "nameDe": { "type": "string" },
    "author": { "type": "string" },
    "tradition": {
      "type": "string",
      "enum": ["rws", "thoth", "marseille", "lenormand", "secular", "open"]
    },
    "description": { "type": "string" },
    "deckContract": {
      "type": "object",
      "required": ["minCards"],
      "properties": {
        "minCards": {
          "type": "integer",
          "minimum": 1
        },
        "requiredArcana": {
          "type": "string",
          "enum": ["any", "major_only", "minor_only", "full_78", "lenormand_36"],
          "default": "any"
        },
        "allowReversals": {
          "type": "boolean",
          "default": true
        },
        "significatorRequired": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "label", "role", "layout"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "label": { "type": "string" },
          "labelDe": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "querent",
              "situation",
              "obstacle",
              "foundation",
              "past",
              "crown_aspiration",
              "near_future",
              "self_attitude",
              "environment",
              "hopes_fears",
              "outcome",
              "clarifier",
              "advice",
              "synthesis"
            ]
          },
          "layout": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {
                "description": "Normierte X-Koordinate (z. B. 0 bis 100 oder Grid-Raster)",
                "type": "number"
              },
              "y": {
                "description": "Normierte Y-Koordinate (z. B. 0 bis 100 oder Grid-Raster)",
                "type": "number"
              },
              "rotation": {
                "description": "Rotationswinkel in Grad (z. B. 90 für orthogonale Kreuzkarten)",
                "type": "number",
                "default": 0
              },
              "layer": {
                "description": "Z-Ebene / Stapel-Reihenfolge (0 = Basistisch, 1 = aufliegend)",
                "type": "integer",
                "default": 0
              }
            },
            "additionalProperties": false
          },
          "filter": {
            "type": "string",
            "enum": ["all", "major_only", "court_only", "minor_numbered_only"]
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "crosses",
              "grounds",
              "crowns",
              "leads_to",
              "mirrors",
              "opposes",
              "clarifies",
              "synthesizes"
            ]
          },
          "tension": {
            "description": "Polarität / inhärente Spannung (-1.0 antagonistisch/feindlich, 0 neutral, +1.0 harmonisch/nährend)",
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "evaluateElementalDignity": {
            "description": "Wenn true, wird das Kantengewicht durch die Elementen-Paarung (Feuer/Wasser/Luft/Erde) dynamisch moduliert",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
