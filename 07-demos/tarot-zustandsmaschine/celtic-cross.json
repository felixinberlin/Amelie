      "order": 1,
      "label": "The Heart of the Matter (Present)",
      "labelDe": "Die Gegenwart (Das Thema)",
      "role": "situation",
      "layout": { "x": 30, "y": 50, "rotation": 0, "layer": 0 }
    },
    {
