@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Tests for recurrence ranking (BACKLOG #1)."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+SCRIPTS = Path(__file__).parent.parent / "scripts"
+sys.path.insert(0, str(SCRIPTS))
+
+from lib.recurrence import (  # noqa: E402
+    tokenize,
+    cluster_learnings,
+    find_ineffective_entries,
+    format_report,
+)
+
+
+def item(msg, ts="2026-09-01T10:00:00Z"):
+    return {"type": "auto", "message": msg, "timestamp": ts,
+            "project": "/p", "confidence": 0.7, "sentiment": "correction"}
+
+
+# Shaped after the 2026-09-19 census in BACKLOG.md: one rule restated four
+# ways over months, drowned in one-off redirects.
+QUEUE = [
+    item("no, use unipile mcp", "2026-06-02T09:00:00Z"),
+    item("no, lets discuss first, show me", "2026-06-03T09:00:00Z"),
+    item("actually, rename it to handler", "2026-06-10T09:00:00Z"),
+    item("use the unipile mcp for linkedin, not the browser", "2026-07-14T09:00:00Z"),
+    item("no, the other file", "2026-07-15T09:00:00Z"),
+    item("wrong file, look in config.py", "2026-07-20T09:00:00Z"),
+    item("actually go through unipile", "2026-08-01T09:00:00Z"),
+    item("no, smaller font on the header", "2026-08-05T09:00:00Z"),
+    item("why didn't you use unipile mcp?", "2026-09-11T09:00:00Z"),
+    item("stop, revert that", "2026-09-12T09:00:00Z"),
+    item("use pnpm not npm", "2026-09-13T09:00:00Z"),
+    item("no need to explain, just do it", "2026-09-14T09:00:00Z"),
+]
+
+
+# A noisier queue: mostly one-offs, a few true repeats, and shared generic
+# words ("tests", "commit", "file") that single-link used to chain into blobs.
+NOISY = [item(m, "2026-09-%02dT10:00:00Z" % (i % 28 + 1)) for i, m in enumerate("""\
+no, the other file
+wrong file, look in config.py
+stop, revert that
+don't touch the tests
+use pnpm not npm
+no, run the tests first
+don't commit yet
+use pnpm please, not npm
+no, write it in typescript
+don't commit to main, open a PR
+no, i said typescript
+actually, run tests before you commit
+nein, bitte auf deutsch antworten
+antworte auf deutsch""".splitlines())]
+
+
+class TestTokenize(unittest.TestCase):
+    def test_keeps_distinctive_tokens_whole(self):
+        self.assertEqual(tokenize("No, use gpt-5.1 in src/api"), ["gpt-5.1", "src/api"])
+
+    def test_drops_openers(self):
+        self.assertEqual(tokenize("actually, no, don't"), [])
+
+    def test_handles_none_and_non_ascii(self):
+        self.assertEqual(tokenize(None), [])
+        self.assertIn("größe", tokenize("nein, die Größe"))
+
+
+class TestClustering(unittest.TestCase):
+    def test_recurring_rule_ranks_first(self):
+        top = cluster_learnings(QUEUE)[0]
+        self.assertEqual(top["size"], 4)
+        self.assertIn("unipile", top["key_terms"])
+        self.assertEqual(top["distinct_days"], 4)
+        self.assertEqual(top["first_seen"][:10], "2026-06-02")
+        self.assertEqual(top["last_seen"][:10], "2026-09-11")
+
+    def test_one_off_redirects_stay_single(self):
+        clusters = cluster_learnings(QUEUE)
+        recurring = [c for c in clusters if c["size"] >= 2]
+        self.assertEqual(len(recurring), 1, [c["messages"] for c in recurring])
+
+    def test_every_item_lands_in_exactly_one_cluster(self):
+        idx = sorted(i for c in cluster_learnings(QUEUE) for i in c["indices"])
+        self.assertEqual(idx, list(range(len(QUEUE))))
+
+    def test_empty_and_malformed(self):
+        self.assertEqual(cluster_learnings([]), [])
+        out = cluster_learnings([{}, None, {"message": 3}, item("")])
+        self.assertEqual(sum(c["size"] for c in out), 4)
+
+    def test_same_day_repeats_count_one_day(self):
+        q = [item("use pnpm", "2026-09-01T10:00:00Z"),
+             item("pnpm please", "2026-09-01T11:00:00Z")]
+        c = cluster_learnings(q)[0]
+        self.assertEqual((c["size"], c["distinct_days"]), (2, 1))
+
+    def test_similarity_fn_is_pluggable(self):
+        # A semantic layer can replace the lexical one without touching
+        # the clustering: here, a stub that calls everything the same.
+        out = cluster_learnings(QUEUE, similarity_fn=lambda a, b: 1.0)
+        self.assertEqual(len(out), 1)
+
+
+    def test_no_chaining_through_generic_words(self):
+        clusters = cluster_learnings(NOISY)
+        for c in clusters:
+            if c["size"] >= 2:
+                # every recurring cluster shares at least one real term
+                self.assertTrue(c["key_terms"], c["messages"])
+        sets = [set(c["messages"]) for c in clusters]
+        self.assertIn({"use pnpm not npm", "use pnpm please, not npm"}, sets)
+        self.assertIn({"no, write it in typescript", "no, i said typescript"}, sets)
+        self.assertIn({"nein, bitte auf deutsch antworten", "antworte auf deutsch"}, sets)
+        self.assertIn({"stop, revert that"}, sets)
+        self.assertIn({"no, the other file"}, sets)
+
+
+class TestIneffectiveEntries(unittest.TestCase):
+    def test_recurring_correction_with_existing_rule_is_flagged(self):
+        memory = [
+            {"text": "Use the unipile MCP for LinkedIn", "source_file": "CLAUDE.md",
+             "source_type": "root", "line_number": 12},
+            {"text": "Prefer small commits", "source_file": "CLAUDE.md",
+             "source_type": "root", "line_number": 13},
+        ]
