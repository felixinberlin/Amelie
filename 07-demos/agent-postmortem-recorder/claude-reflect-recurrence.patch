+#!/usr/bin/env python3
+"""Run capture_learning.py the way Claude Code runs it (BACKLOG #3).
+
+The CI smoke step pipes {"prompt":"test"}, which is not a correction, so the
+capture-and-write path never executes there. These tests pipe real
+corrections through the hook as a subprocess, against a throwaway HOME, and
+check the queue file lands where Claude Code's transcript says it should.
+Runs on all three CI platforms as part of the normal pytest step.
+"""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+HOOK = Path(__file__).parent.parent / "scripts" / "capture_learning.py"
+
+
+class TestCaptureHookEndToEnd(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.home = Path(self._tmp.name)
+        self.folder = self.home / ".claude" / "projects" / "-work-demo-app"
+        self.transcript = self.folder / "0000-session.jsonl"
+        self.env = dict(os.environ)
+        # Path.home(): HOME on POSIX, USERPROFILE on Windows.
+        self.env["HOME"] = str(self.home)
+        self.env["USERPROFILE"] = str(self.home)
+        # Do NOT force UTF-8: the Windows bugs lived in the default codepage.
+        self.env.pop("PYTHONIOENCODING", None)
+        self.env.pop("PYTHONUTF8", None)
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def run_hook(self, prompt):
+        payload = json.dumps({"prompt": prompt, "transcript_path": str(self.transcript)})
+        return subprocess.run(
+            [sys.executable, str(HOOK)], input=payload.encode("utf-8"),
+            capture_output=True, env=self.env, cwd=str(self.home), timeout=30)
+
+    def queue(self):
+        return json.loads((self.folder / "learnings-queue.json").read_text(encoding="utf-8"))
+
+    def test_correction_is_written_to_transcript_folder(self):
+        r = self.run_hook("no, use python not python3")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(r.stderr, b"")
+        self.assertIn(b"Learning captured", r.stdout)
+        q = self.queue()
+        self.assertEqual(len(q), 1)
+        self.assertEqual(q[0]["message"], "no, use python not python3")
+
+    def test_non_ascii_correction_survives_default_codepage(self):
+        r = self.run_hook("no, use the café-api not the old one")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(r.stderr, b"")
+        self.assertEqual(self.queue()[0]["message"], "no, use the café-api not the old one")
+
+    def test_two_captures_append(self):
+        self.run_hook("no, use python not python3")
+        self.run_hook("don't use npm, use pnpm")
+        self.assertEqual(len(self.queue()), 2)
+
+    def test_non_correction_leaves_empty_queue(self):
+        r = self.run_hook("test")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(self.queue(), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
