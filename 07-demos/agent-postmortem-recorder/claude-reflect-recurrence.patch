+#!/usr/bin/env python3
+"""Rank queued learnings by recurrence (BACKLOG #1).
+
+A one-off redirect ("no, lets discuss first") almost never comes back.
+A real rule ("use unipile mcp") comes back, in new wording, until it is
+written down. So recurrence is the cheapest signal we have for "this is a
+rule, not a moment" -- and it is already in the queue.
+
+This module is deliberately small:
+  * stdlib only, Python 3.6+ syntax, no network, no `claude -p` calls
+  * read-only: it never writes the queue or any memory file
+  * lexical, IDF-weighted similarity; `similarity_fn` lets /reflect plug
+    in the semantic layer later without changing the clustering code
+
+It also reports a second thing the current flow loses: a cluster that
+recurs even though a matching memory entry already exists. Step 4 of
+/reflect treats that as a duplicate to skip. It is the opposite: evidence
+that the existing entry is not working (wording, placement, or it wants
+to be a hook).
+"""
+import math
+import re
+from datetime import datetime
+from typing import Any, Callable, Dict, List, Optional, Sequence
+
+# Correction openers and filler that carry no topic. Kept short on purpose:
+# IDF weighting already discounts words that are common *in this queue*.
+_STOPWORDS = set("""
+a an the and or but if then so to of in on at for from by with without into
+is are was were be been being am do does did done doing have has had
+i you he she it we they me my your our their this that these those there here
+no not dont don't never always please just actually instead again also
+use using used make made let lets let's go going get got want need should
+can could would will shall may might must
+what why how when where which who
+ok okay yes yeah hmm wait stop now first
+don didn doesn isn wasn won can't won't didn't doesn't isn't
+through via instead other another same one thing things way bit
+file files code look show see try tell explain here there it's
+wrong right correct meant said told asked
+""".split())
+
+_TOKEN_RE = re.compile(r"[\w][\w.\-/]*", re.UNICODE)
+
+SimilarityFn = Callable[[str, str], float]
+
+
+def tokenize(text: str) -> List[str]:
+    """Lower-case content tokens, openers and stopwords removed.
+
+    Tokens keep internal dots, dashes and slashes so `gpt-5.1`, `src/api`
+    and `package.json` survive as one token -- those are usually the
+    distinctive part of a rule.
+    """
+    out = []
+    for raw in _TOKEN_RE.findall((text or "").lower()):
+        tok = raw.strip(".-/")
+        if len(tok) < 2 or tok in _STOPWORDS:
+            continue
+        out.append(tok)
+    return out
+
+
+def _idf_table(docs: Sequence[Sequence[str]]) -> Dict[str, float]:
+    n = max(len(docs), 1)
+    df: Dict[str, int] = {}
+    for toks in docs:
+        for t in set(toks):
+            df[t] = df.get(t, 0) + 1
+    # Smoothed IDF; a token present in every item still weighs > 0.
+    return {t: math.log((n + 1) / (c + 0.5)) for t, c in df.items()}
+
+
+def weighted_overlap(a: Sequence[str], b: Sequence[str], idf: Dict[str, float]) -> float:
+    """IDF-weighted overlap coefficient in [0, 1].
+
+    Overlap (not Jaccard) because a rule is often restated short once and
+    long once: "use unipile" vs "for linkedin always go through the unipile
+    mcp". The shared rare token should dominate.
+    """
+    sa, sb = set(a), set(b)
+    if not sa or not sb:
+        return 0.0
+    default = max(idf.values()) if idf else 1.0
+    w = lambda toks: sum(idf.get(t, default) for t in toks)
+    denom = min(w(sa), w(sb))
+    return w(sa & sb) / denom if denom > 0 else 0.0
+
+
+def _parse_ts(value: Any) -> Optional[datetime]:
+    if not isinstance(value, str):
+        return None
+    try:
+        return datetime.strptime(value[:19], "%Y-%m-%dT%H:%M:%S")
+    except ValueError:
+        return None
+
+
+def cluster_learnings(
+    items: List[Dict[str, Any]],
+    threshold: float = 0.6,
+    similarity_fn: Optional[SimilarityFn] = None,
+) -> List[Dict[str, Any]]:
+    """Group queue items that say the same thing, then rank the groups.
+
+    Returns a list of clusters, most-recurring first:
+      {
+        "size": 4,                       # how many queue items
+        "distinct_days": 3,              # recurrence across days, not one rant
+        "first_seen": "2026-06-02T...",  # ISO strings from the queue
+        "last_seen":  "2026-09-11T...",
+        "indices": [3, 17, 40, 88],      # positions in the input list
+        "messages": ["no, use unipile mcp", ...],
+        "key_terms": ["unipile", "mcp"], # shared distinctive tokens
+      }
+
+    Complete-link agglomerative clustering over an n x n similarity
+    matrix: ~5k pairs for a 100-item queue -- instant, no index needed.
+    """
+    messages = [str((it or {}).get("message", "")) for it in items]
+    toks = [tokenize(m) for m in messages]
+    idf = _idf_table(toks)
+    # A token seen in only one item cannot be evidence of recurrence, but it
+    # does dilute the overlap ("actually go *through* unipile"). Compare on
+    # tokens that occur at least twice in this batch.
+    df: Dict[str, int] = {}
+    for t_list in toks:
+        for t in set(t_list):
+            df[t] = df.get(t, 0) + 1
+    link_toks = [[t for t in t_list if df[t] >= 2] for t_list in toks]
+
+    def sim(i: int, j: int) -> float:
+        if similarity_fn is not None:
+            return similarity_fn(messages[i], messages[j])
+        return weighted_overlap(link_toks[i], link_toks[j], idf)
+
+    # Complete-link: two groups merge only if EVERY cross pair is similar.
+    # Single-link chains ("tests" -> "run tests before commit" -> "commit")
+    # into blobs that rank high for the wrong reason.
+    n = len(items)
+    S = [[0.0] * n for _ in range(n)]
+    pairs = []
+    for i in range(n):
+        for j in range(i + 1, n):
+            S[i][j] = S[j][i] = sim(i, j)
+            if S[i][j] >= threshold:
+                pairs.append((S[i][j], i, j))
+    pairs.sort(key=lambda p: -p[0])
+
+    member_of = list(range(n))            # item -> group id
+    group_members: Dict[int, List[int]] = {i: [i] for i in range(n)}
+    for _, i, j in pairs:
+        gi, gj = member_of[i], member_of[j]
+        if gi == gj:
+            continue
+        a, b = group_members[gi], group_members[gj]
+        if all(S[x][y] >= threshold for x in a for y in b):
+            for y in b:
+                member_of[y] = gi
+            a.extend(b)
+            del group_members[gj]
+
+    groups = {g: sorted(m) for g, m in group_members.items()}
+
+    clusters = []
+    for idxs in groups.values():
+        stamps = [(items[i] or {}).get("timestamp") for i in idxs]
+        parsed = sorted(p for p in (_parse_ts(s) for s in stamps) if p)
+        days = {p.date() for p in parsed}
+        iso = sorted(s for s in stamps if isinstance(s, str))
+        shared = set(toks[idxs[0]])
+        for i in idxs[1:]:
+            shared &= set(toks[i])
+        key_terms = sorted(shared, key=lambda t: -idf.get(t, 0.0))[:5]
+        clusters.append({
+            "size": len(idxs),
+            "distinct_days": len(days) if days else len(idxs),
+            "first_seen": iso[0] if iso else None,
+            "last_seen": iso[-1] if iso else None,
+            "indices": idxs,
+            "messages": [messages[i] for i in idxs],
+            "key_terms": key_terms,
+        })
+
+    # Two stable sorts: newest first, then by recurrence (size, spread).
+    clusters.sort(key=lambda c: c["last_seen"] or "", reverse=True)
+    clusters.sort(key=lambda c: (-c["size"], -c["distinct_days"]))
+    return clusters
+
+
+def find_ineffective_entries(
+    clusters: List[Dict[str, Any]],
+    memory_entries: List[Dict[str, Any]],
+    threshold: float = 0.6,
+    min_size: int = 2,
+) -> List[Dict[str, Any]]:
+    """Recurring clusters that an existing memory entry already covers.
+
+    `memory_entries` is the output of reflect_utils.read_all_memory_entries():
+    [{text, source_file, source_type, line_number}, ...].
+
+    A hit means: the rule is written down, yet the user kept correcting the
+    same thing. Worth showing as "rewrite / move / make it a hook", never as
+    "duplicate, skip". It is a hypothesis, not a verdict -- the corrections
+    may predate the entry; first_seen/last_seen are included so the human
+    can tell.
+    """
+    corpus = [tokenize(e.get("text", "")) for e in memory_entries]
+    hits = []
+    for c in clusters:
+        if c["size"] < min_size:
+            continue
+        ctoks = [tokenize(m) for m in c["messages"]]
+        idf = _idf_table(corpus + ctoks)
+        best, best_score = None, 0.0
+        for entry, etoks in zip(memory_entries, corpus):
+            score = max(weighted_overlap(ct, etoks, idf) for ct in ctoks)
+            if score > best_score:
+                best, best_score = entry, score
+        if best is not None and best_score >= threshold:
+            hits.append({"cluster": c, "entry": best, "score": round(best_score, 2)})
+    return hits
+
+
+def format_report(
+    clusters: List[Dict[str, Any]],
+    ineffective: Optional[List[Dict[str, Any]]] = None,
+    min_size: int = 2,
+) -> str:
+    """Plain-text report in the box style /reflect already uses."""
+    bar = "═" * 60
+    rec = [c for c in clusters if c["size"] >= min_size]
+    singles = sum(1 for c in clusters if c["size"] < min_size)
+    total = sum(c["size"] for c in clusters)
+    lines = [bar, "RECURRING CORRECTIONS — %d of %d items recur" % (
+        sum(c["size"] for c in rec), total), bar, ""]
+    if not rec:
+        lines.append("No correction appears twice. Nothing ranks above the rest.")
+    for n, c in enumerate(rec, 1):
+        span = ""
+        if c["first_seen"] and c["last_seen"]:
+            span = "  %s → %s" % (c["first_seen"][:10], c["last_seen"][:10])
+        lines.append("#%d  ×%d over %d day(s)%s   [%s]" % (
+            n, c["size"], c["distinct_days"], span, ", ".join(c["key_terms"])))
+        for m in c["messages"][:4]:
+            lines.append('      "%s"' % (m if len(m) <= 90 else m[:87] + "..."))
+        lines.append("")
+    if ineffective:
+        lines += ["─" * 60,
+                  "ALREADY WRITTEN DOWN, STILL CORRECTED — %d" % len(ineffective),
+                  "─" * 60]
+        for h in ineffective:
+            e = h["entry"]
+            lines.append("  %s:%s  \"%s\"" % (e.get("source_file"), e.get("line_number"), e.get("text")))
+            lines.append("      ↑ corrected ×%d anyway (%s → %s). Rewrite, move, or make it a hook?" % (
+                h["cluster"]["size"],
+                (h["cluster"]["first_seen"] or "?")[:10],
+                (h["cluster"]["last_seen"] or "?")[:10]))
+        lines.append("")
+    lines.append("%d one-off item(s) below — review last." % singles)
+    return "\n".join(lines)
