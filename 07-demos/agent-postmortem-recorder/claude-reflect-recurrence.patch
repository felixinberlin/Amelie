+#!/usr/bin/env python3
+"""Rank this project's learnings queue by recurrence. Read-only.
+
+Usage:
+    python3 rank_queue.py                    # current project's queue
+    python3 rank_queue.py --queue FILE       # any queue file
+    python3 rank_queue.py --json             # machine-readable, for /reflect
+    python3 rank_queue.py --no-memory        # skip the "still corrected" check
+
+Options:
+    --threshold X   similarity needed to join a cluster (default 0.6)
+    --min-size N    cluster size that counts as recurring (default 2)
+"""
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from lib.reflect_utils import (  # noqa: E402
+    ensure_utf8_io,
+    get_queue_path,
+    load_queue_at,
+    read_all_memory_entries,
+)
+from lib.recurrence import (  # noqa: E402
+    cluster_learnings,
+    find_ineffective_entries,
+    format_report,
+)
+
+
+def main(argv=None) -> int:
+    ensure_utf8_io()
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("--queue", help="queue file (default: this project's)")
+    p.add_argument("--json", action="store_true")
+    p.add_argument("--no-memory", action="store_true")
+    p.add_argument("--threshold", type=float, default=0.6)
+    p.add_argument("--min-size", type=int, default=2)
+    args = p.parse_args(argv)
+
+    # load_queue_at, not load_queue: no migrations, no side effects.
+    path = Path(args.queue) if args.queue else get_queue_path()
+    items = load_queue_at(path)
+    clusters = cluster_learnings(items, threshold=args.threshold)
+
+    ineffective = []
+    if not args.no_memory:
+        try:
+            ineffective = find_ineffective_entries(
+                clusters, read_all_memory_entries(),
+                threshold=args.threshold, min_size=args.min_size)
+        except Exception:  # memory discovery must never break ranking
+            ineffective = []
+
+    if args.json:
+        print(json.dumps({"queue": str(path), "clusters": clusters,
+                          "ineffective": ineffective}, indent=2))
+    else:
+        print(format_report(clusters, ineffective, min_size=args.min_size))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
