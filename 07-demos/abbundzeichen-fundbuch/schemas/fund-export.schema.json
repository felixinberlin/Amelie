{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://felixinberlin.github.io/Amelie/07-demos/abbundzeichen-fundbuch/schemas/fund-export.schema.json",
  "title": "Abbundzeichen-Fundbuch — Fund-Export",
  "description": "Exportformat einer Erfassung für kuratierende Hausforschende. Die Erfassungsfelder (Markierungsart, Werkzeug, Lage, Serie) sind an die in Vernacular Architecture 49/1 (2018) geforderte einheitliche Erfassung ANGELEHNT; der Artikel wurde nicht im Volltext gelesen, die Abbildung auf dessen Terminologie ist ungeprüft. Ort nur auf Gemeindeebene. Befunde tragen nur die Stufen 'hinweis' oder 'verdacht' — nie einen bestätigten Befund. CC0 1.0 Public Domain.",
  "type": "object",
  "required": ["format", "version", "ortsgenauigkeit", "ort", "erfasstAm", "bauteile", "befunde", "unlesbar", "vorbehaltDe", "vorbehaltEn"],
  "additionalProperties": false,
  "definitions": {
    "serie": {
      "type": "object",
      "required": ["typ", "anzahl"],
      "additionalProperties": false,
      "properties": {
        "typ": { "type": "string", "enum": ["keine", "ausstich", "faehnchen", "beistrich", "kreis"] },
        "anzahl": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "format": { "const": "abbundzeichen-fundbuch" },
    "version": { "type": "string" },
    "ortsgenauigkeit": { "const": "gemeinde" },
    "ort": {
      "type": "object",
      "required": ["gemeinde", "landkreis", "land"],
      "additionalProperties": false,
      "properties": {
        "gemeinde": { "type": "string", "minLength": 1 },
        "landkreis": { "type": ["string", "null"] },
        "land": { "type": "string", "minLength": 1 }
      }
    },
    "erfasstAm": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gebaeudeart": { "type": ["string", "null"] },
    "bemerkung": { "type": ["string", "null"] },
    "bauteile": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "zeichen", "markierungsart", "werkzeug", "lage", "serie", "lesung"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "zeichen": { "type": "string" },
          "markierungsart": { "type": "string", "enum": ["eingeschlagen", "geritzt", "gerissen", "geroetelt", "unbekannt"] },
          "werkzeug": { "type": "string", "enum": ["stemmeisen", "reissmesser", "beil", "saege", "roetel", "unbekannt"] },
          "lage": {
            "type": "object",
            "required": ["wand", "position", "rolle", "seite"],
            "additionalProperties": false,
            "properties": {
              "wand": { "type": "string" },
              "position": { "type": "number" },
              "rolle": { "type": "string" },
              "seite": { "type": ["string", "null"] }
            }
          },
          "serie": { "oneOf": [{ "$ref": "#/definitions/serie" }, { "type": "null" }] },
          "lesung": {
            "oneOf": [
              {
                "type": "object",
                "required": ["zustand", "wert", "notation"],
                "additionalProperties": false,
                "properties": {
                  "zustand": { "const": "gelesen" },
                  "wert": { "type": "integer", "minimum": 1 },
                  "notation": { "type": "string", "enum": ["additiv", "subtraktiv", "neutral"] }
                }
              },
              {
                "type": "object",
                "required": ["zustand"],
                "additionalProperties": false,
                "properties": { "zustand": { "const": "unlesbar" } }
              }
            ]
          }
        }
      }
    },
    "befunde": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["regel", "stufe", "wand", "bauteile", "textDe", "textEn"],
        "additionalProperties": false,
        "properties": {
          "regel": { "type": "string", "enum": ["R1-LUECKE", "R2-DOPPELUNG", "R3-FREMDE-SERIE", "R4-NOTATIONSBRUCH", "R5-RICHTUNGSBRUCH"] },
          "stufe": { "type": "string", "enum": ["hinweis", "verdacht"] },
          "wand": { "type": "string" },
          "bauteile": { "type": "array", "items": { "type": "string" } },
          "textDe": { "type": "string", "minLength": 1 },
          "textEn": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unlesbar": { "type": "array", "items": { "type": "string" } },
    "vorbehaltDe": { "type": "string" },
    "vorbehaltEn": { "type": "string" }
  }
}
