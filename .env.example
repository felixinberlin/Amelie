# The Amélie application runs 100% statically on GitHub Pages without any required keys.
# Optional: To enable live Google Workspace (Docs/Gmail) imports via Firebase Auth,
# define the following public client-side variables (e.g. in GitHub Repository Secrets):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
