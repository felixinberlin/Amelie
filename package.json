    "check:books": "node scripts/check-dose-books.mjs",
    "check:idea-frontmatter": "node scripts/sync-idea-frontmatter.mjs --check",
    "check:protokoll": "node scripts/check-protokoll-coverage.mjs",
    "export:data": "node scripts/export-public-data.mjs",
    "sync:idea-frontmatter": "node scripts/sync-idea-frontmatter.mjs"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.14",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
