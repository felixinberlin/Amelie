{
  "name": "zero-drift-swarm-kit",
  "version": "1.0.0",
  "description": "Production-grade autonomous multi-agent swarm boilerplate for Claude Code, Antigravity, and Cursor. Zero merge conflicts, mechanical drift guards, and structured memory.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit && node scripts/check-drift.mjs && node scripts/check-graveyard.mjs",
    "drift": "node scripts/check-drift.mjs",
    "graveyard": "node scripts/graveyard-muster.mjs",
    "check:graveyard": "node scripts/check-graveyard.mjs"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "multi-agent",
    "antigravity",
    "cursor",
    "agentic-engineering",
    "drift-guards"
  ],
  "author": "Felix <felix@tortilladepatas.de>",
  "license": "Commercial",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": ">=3"
  }
}
