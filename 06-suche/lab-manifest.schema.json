{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lab-manifest",
  "description": "One manifest per Lab pull request into Amélie: what the PR contains, in a form Amélie's checks can read. Written by the Lab (plan builder), never by a model. Proposed by the Lab, field names agreed with the Amélie orchestrator on 2026-09-30.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "plan_id",
    "engine",
    "model",
    "existence_check",
    "survivors",
    "files",
    "source_ops",
    "grave_proposals",
    "touches_memory"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "minLength": 5,
      "maxLength": 20
    },
    "manifest_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "engine": {
      "type": "string",
      "enum": [
        "lacunar",
        "inversion",
        "review"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "existence_check": {
      "type": "boolean",
      "description": "Same as the mandatory line 'Existenzprüfung: ja|nein' in the PR text."
    },
    "survivors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "status"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string",
          "enum": [
            "ungeprueft",
            "geprueft",
            "keine"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "source_ops": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "id",
          "human_accepted",
          "urls"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "source.add",
              "source.log"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "human_accepted": {
            "type": "boolean"
          },
          "urls": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    },
    "grave_proposals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "touches_memory": {
      "type": "boolean"
    },
    "contracts": {
      "type": "object",
      "description": "Contract versions of the Lab messages this PR was built from, and the bib schema version seen.",
      "additionalProperties": {
        "type": "string",
        "maxLength": 40
      }
    }
  }
}
